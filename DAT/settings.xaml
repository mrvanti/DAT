<Window x:Class="DAT.settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inställningar" Height="240" Width="290" ResizeMode="NoResize" ShowInTaskbar="False" 
        FontSize="18">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0">
            <TextBlock Text="Matchtid:" />
            <TextBox x:Name="matchTid" Margin="10,0,0,0" HorizontalAlignment="Left" Width="40" Text="2:00"></TextBox>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Vit ska synas till:" />
            <StackPanel Margin="15,0,0,0">
                <RadioButton x:Name="Höger" Content="Höger" Checked="Höger_Click"></RadioButton>
                <RadioButton x:Name="Vänster" Content="Vänster" Checked="Vänster_Click"></RadioButton>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0">
            <TextBlock Text="Färgval:" />
            <StackPanel Margin="15,0,0,0">
                <RadioButton x:Name="Blå" Content="Blå" Checked="Blå_Click"></RadioButton>
                <RadioButton x:Name="Röd" Content="Röd" Checked="Röd_Click"></RadioButton>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin=" 0 -5 0 0">
            <Button Style="{StaticResource Button}" Content="Spara" Width="60" Height="28" Margin="2" Click="Save_Click"/>
            <Button Style="{StaticResource Button}" Content="Avbryt" Width="60" Height="28" Margin="2" Click="Cancel_Click"/>
        </StackPanel>

    </Grid>
</Window>
