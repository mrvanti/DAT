<Window x:Class="DAT.settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="188" Width="241" ResizeMode="NoResize" ShowInTaskbar="False" 
        >

    <Grid>
        <StackPanel>

            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Matchtid:" />
                <TextBox x:Name="matchTid" Margin="15,0,0,0" HorizontalAlignment="Left" Width="30" Text="2:00"></TextBox>
            </StackPanel>
            <StackPanel Orientation="Vertical" Margin="10">
                <TextBlock Text="Färgval:" />
                <StackPanel Margin="15,0,0,0">
                    <RadioButton x:Name="Blå" Content="Blå" Checked="Blå_Click"></RadioButton>
                    <RadioButton x:Name="Röd" Content="Röd" Checked="Röd_Click"></RadioButton>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0">
                <Button Content="Spara" Width="45" Margin="5" Click="Save_Click"/>
                <Button Content="Avbryt" Width="45" Margin="5" Click="Cancel_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
